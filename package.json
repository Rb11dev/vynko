{
  "name": "vynko",
  "version": "0.1.0",
  "private": true,
  "description": "VYNKO - real-time audio, video calling and messaging (Next.js + Socket.IO + WebRTC + SQLite)",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node --disable-warning=ExperimentalWarning server/index.mjs",
    "build": "next build",
    "start": "node --disable-warning=ExperimentalWarning server/index.mjs --prod",
    "db:migrate": "node --disable-warning=ExperimentalWarning scripts/migrate.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test \"tests/*.test.mjs\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run test && npm run typecheck"
  },
  "dependencies": {
    "lucide-react": "0.453.0",
    "next": "^16.4.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "socket.io": "4.8.1",
    "socket.io-client": "4.8.1"
  },
  "devDependencies": {
    "@types/node": "22.7.5",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.20",
    "postcss": "^8.5.32",
    "tailwindcss": "3.4.14",
    "typescript": "5.6.3"
  }
}
