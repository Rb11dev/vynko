# =====================================================================
# VYNKO configuration
# Copy this file to ".env" (or just run `npm run setup`, which does it
# for you and generates a random SESSION_SECRET).
# NEVER commit your real .env file. This example holds placeholders only.
# =====================================================================

# Port the server listens on.
PORT=3000

# Public address of the app, no trailing slash.
# Local development: http://localhost:3000
# Production: your https:// domain, e.g. https://vynko.example.com
APP_URL=http://localhost:3000

# REQUIRED. A long random secret (32+ characters) used to protect sessions.
# `npm run setup` fills this in for you. To make one by hand:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If you change it, every user is logged out.
SESSION_SECRET=

# SQLite database file. Back this file up (see README).
DATABASE_PATH=./data/vynko.db

# STUN servers help browsers discover their public address (comma separated).
# A public STUN server is NOT a guarantee that every call will connect.
STUN_URLS=stun:stun.l.google.com:19302

# OPTIONAL: TURN relay for networks where direct peer-to-peer fails
# (strict corporate Wi-Fi, some mobile carriers). Set all three or none.
# TURN servers cost bandwidth, so they are usually paid or self-hosted
# (e.g. coturn). Without TURN, some calls will fail to connect.
# Example URL: turn:turn.example.com:3478  (comma separate several)
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# OPTIONAL: extra browser origins allowed to call the API / WebSocket
# (comma separated). Defaults to APP_URL.
ALLOWED_ORIGINS=

# Set to true ONLY when running behind a reverse proxy you control
# (nginx, Caddy, a hosting platform) so client IPs are read correctly
# for rate limiting.
TRUST_PROXY=false

# OPTIONAL: force the cookie "Secure" flag. Default: on when APP_URL is https.
COOKIE_SECURE=

# OPTIONAL: only if the signaling server runs on a different address than the
# website. Leave empty to use the same address (recommended, simplest).
NEXT_PUBLIC_SIGNALING_URL=
